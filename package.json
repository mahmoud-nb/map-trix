{
  "name": "map-trix",
  "version": "1.4.4",
  "description": "This module provides an easy to use interface that allows to load and use Google Maps API",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "author": {
    "name": "Mahmoud NBET",
    "email": "mahmoud.nb@gmail.com"
  },
  "keywords": [
    "google",
    "maps",
    "loader",
    "interface",
    "typescript"
  ],
  "homepage": "https://github.com/mahmoud-nb/map-trix",
  "repository": {
    "type": "git",
    "url": "git@github.com:mahmoud-nb/map-trix.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && rollup -c rollup.config.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/google.maps": "^3.66.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "rollup": "^4.20.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
