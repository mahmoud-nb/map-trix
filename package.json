{
  "name": "map-trix",
  "version": "3.0.0",
  "description": "One easy-to-use interface to load and use any map client (Google Maps, Leaflet, MapLibre, Mapbox): markers, popups, store locator, routing and clustering.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./google": {
      "types": "./dist/providers/google/index.d.ts",
      "import": "./dist/providers/google/index.esm.js",
      "require": "./dist/providers/google/index.js"
    },
    "./leaflet": {
      "types": "./dist/providers/leaflet/index.d.ts",
      "import": "./dist/providers/leaflet/index.esm.js",
      "require": "./dist/providers/leaflet/index.js"
    },
    "./maplibre": {
      "types": "./dist/providers/maplibre/index.d.ts",
      "import": "./dist/providers/maplibre/index.esm.js",
      "require": "./dist/providers/maplibre/index.js"
    },
    "./mapbox": {
      "types": "./dist/providers/mapbox/index.d.ts",
      "import": "./dist/providers/mapbox/index.esm.js",
      "require": "./dist/providers/mapbox/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "author": {
    "name": "Mahmoud NBET",
    "email": "mahmoud.nb@gmail.com"
  },
  "keywords": [
    "google",
    "maps",
    "leaflet",
    "maplibre",
    "mapbox",
    "map",
    "marker",
    "store-locator",
    "clustering",
    "directions",
    "loader",
    "interface",
    "typescript"
  ],
  "homepage": "https://mahmoud-nb.github.io/map-trix/",
  "repository": {
    "type": "git",
    "url": "git@github.com:mahmoud-nb/map-trix.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && rollup -c rollup.config.js",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:preview": "npm run docs:build && npx --yes http-server site -p 5199 -c-1",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/google.maps": "^3.66.3"
  },
  "peerDependencies": {
    "@googlemaps/markerclusterer": "^2.5.0",
    "leaflet": "^1.9.0",
    "leaflet.markercluster": "^1.5.0",
    "mapbox-gl": ">=2.0.0",
    "maplibre-gl": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@googlemaps/markerclusterer": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "leaflet.markercluster": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.18.0",
    "@googlemaps/markerclusterer": "^2.5.3",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mapbox-gl": "^3.9.0",
    "maplibre-gl": "^6.10.0",
    "rollup": "^4.20.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
